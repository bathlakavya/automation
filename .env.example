EMAIL_TO=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WA_FROM=whatsapp:+14155238886
TWILIO_WA_TO=whatsapp:+91XXXXXXXXXX
NOTION_TOKEN=
NOTION_DATABASE_ID=   # database needs a title property named "Name"

# ---- Classroom fallback (only if your college blocks the API) ----
